# Database: use DATABASE_URL for Postgres (Render), or leave unset for SQLite
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Admin password for protected routes (required)
ADMIN_PASSWORD=changeme

# Optional: secret for session/signing (defaults to ADMIN_PASSWORD if unset)
# SECRET_KEY=your-secret-key

# Optional: OpenAI API key for extracting game data from screenshots (Add past game → upload image)
# OPENAI_API_KEY=sk-...
